#!/usr/bin/env bash
# Stub of StrykerJS 9.x for the seeded mutation-diff test: writes a report in its json reporter format (mutation-testing-report-schema, schemaVersion "1").
# Env: STUB_STATUS mutant status (default Killed), STUB_COUNT mutants per file (default 2), STUB_RAW a file copied as the report, STUB_OMIT=1 leaves the files out, STUB_EXIT exit code, STUB_SPIN=1 burns CPU, STUB_ARGS_LOG logs the arguments.
set -u
[ -n "${STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$STUB_ARGS_LOG"
[ "${STUB_SPIN:-}" = 1 ] && while :; do :; done
mutate=
report=
while [ $# -gt 0 ]; do
  case "$1" in
    --mutate) mutate=$2; shift ;;
    --jsonReporter.fileName) report=$2; shift ;;
  esac
  shift
done
if [ -n "${STUB_RAW:-}" ]; then
  cp "$STUB_RAW" "$report"
  exit "${STUB_EXIT:-0}"
fi
status=${STUB_STATUS:-Killed}
count=${STUB_COUNT:-2}
{
  printf '{"schemaVersion":"1","thresholds":{"high":80,"low":60},"files":{'
  if [ "${STUB_OMIT:-}" != 1 ]; then
    first=1
    old=$IFS
    IFS=,
    for f in $mutate; do
      [ $first = 1 ] || printf ','
      first=0
      printf '"%s":{"language":"typescript","source":"","mutants":[' "$f"
      i=0
      while [ "$i" -lt "$count" ]; do
        [ "$i" = 0 ] || printf ','
        printf '{"id":"%s","mutatorName":"ConditionalExpression","replacement":"true","location":{"start":{"line":3,"column":9},"end":{"line":3,"column":14}},"status":"%s"}' "$i" "$status"
        i=$((i + 1))
      done
      printf ']}'
    done
    IFS=$old
  fi
  printf '}}\n'
} > "$report"
exit "${STUB_EXIT:-0}"

#!/usr/bin/env bash
# Stub of mutmut 3.x for the seeded mutation-diff test: prints what `mutmut run`, `mutmut results --all true` and `mutmut show <name>` print.
# Env: STUB_MODULES space-separated module names, STUB_STATUS status for each mutant (default killed), STUB_COUNT mutants per module (default 2), STUB_EXIT exit code of run, STUB_SPIN=1 burns CPU, STUB_ARGS_LOG logs the arguments.
set -u
[ -n "${STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$STUB_ARGS_LOG"
case "${1:-}" in
  run)
    [ "${STUB_SPIN:-}" = 1 ] && while :; do :; done
    echo "Running mutation testing"
    exit "${STUB_EXIT:-0}"
    ;;
  results)
    echo "Results"
    for m in ${STUB_MODULES:-}; do
      i=1
      while [ "$i" -le "${STUB_COUNT:-2}" ]; do
        printf '    %s.x_handler__mutmut_%s: %s\n' "$m" "$i" "${STUB_STATUS:-killed}"
        i=$((i + 1))
      done
    done
    ;;
  show)
    cat <<DIFF
--- src/app.py
+++ src/app.py
@@ -2,5 +2,5 @@
 def handler(x):
     y = x
-    return y > 0
+    return y >= 0
 
DIFF
    ;;
esac

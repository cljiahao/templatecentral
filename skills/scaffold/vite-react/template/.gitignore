# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
dist/
build/

# vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*


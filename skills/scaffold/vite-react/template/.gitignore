# IDE
.vscode/
.idea/

# typescript
*.tsbuildinfo

# eslint --cache file
.eslintcache
# Local agent symlink (.agents -> .claude) — do not track it: a git-tracked
# symlink breaks Windows CI build agents (e.g. "Unable to load symbolic/hard
# linked file" on Azure DevOps hosted runners). Recreate it per machine.
.agents

# Per-developer skill telemetry written by .claude/hooks/skill-usage-log.sh
.claude/skill-usage.log

# Per-developer gate timings written by .claude/ci-gates.sh and the once-per-session marker from .claude/gate-budget.sh
.claude/gate-times.tsv
.claude/gate-budget.seen
.claude/gate-times.??????
.claude/gate-budget.??????
# Local review records written by scripts/record-review.sh (per machine, never committed)
.claude/review/

# Files the seeded gates write: the diffcover gate's report (CI redirects diff-cover output into it) and the SBOM
diff-cover.txt

{
  "name": "__TC_PROJECT_NAME__",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" && eslint \"{src,test}/**/*.ts\" && tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:cov": "vitest --run --coverage",
    "test:e2e": "vitest --run --config vitest.config.e2e.ts",
    "test:ci": "vitest --run --coverage && vitest --run --config vitest.config.e2e.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "^17.6.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
